    <p class="focus">2</p>
    <button onclick="focusStarted()">Start the focus session</button>
 
    <script>
        // let noOfFocusSession = JSON.parse(localStorage.getItem("focusNumber"))
         document.querySelector(".focus").innerHTML = noOfFocusSession
         
        function focusStarted(){
            noOfFocusSession++
            document.querySelector(".focus").innerHTML = noOfFocusSession
            localStorage.setItem("focusNumber", JSON.stringify(noOfFocusSession))
        }
    </script>
</body>
